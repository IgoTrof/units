Ниже — минимально-инвазивные исправления (код уже в эксплуатации).
Изменения только в критичных местах, помечены // ✅ FIX.
Полный текст обоих компонентов.

// ======================================================================================================================
//                                     1. FlatTableInfinity.jsx (полный текст с фиксами)
// ======================================================================================================================


import React, { useEffect, useMemo, useRef, useState } from 'react';
import {
  useReactTable,
  getCoreRowModel,
  flexRender,
  getSortedRowModel
} from "@tanstack/react-table";

import AddCircleOutlineIcon from "@mui/icons-material/AddCircleOutline";
import EditIcon from "@mui/icons-material/Edit";
import DeleteForeverIcon from '@mui/icons-material/DeleteForever';
import FilterListIcon from "@mui/icons-material/FilterList";
import RefreshIcon from "@mui/icons-material/Refresh";
import { Box, CircularProgress, Typography } from '@mui/material';

import FilterDialog from '../../../pages/FilterDialog';
import { formatDate } from '../../../utils/dateUtils';
import { CanAccess, hasPermission, useUiPermission } from '../../../context/PermissionsContext';

/**
 * Универсальная плоская таблица с поддержкой:
 * - оптимистичного обновления
 * - фильтров
 * - CRUD-формы
 * - прав доступа
 * - опционального бесконечного скролла
 */
const FlatTableInfinity = ({
  title = "",
  pageName = "",
  visibleToolbarButtons = ['add', 'filter', 'refresh', 'Действия'],
  data,
  columns,
  pk,
  setData,
  reloadData,
  FormComponent,
  initialNewIdent = "",
  onApplyFilters,
  loading = false,
  FilterComponent,
  filterConfig = {},
  onRowSelect,
  record = null,
  activeRecord = null,

  // ===== Infinite scroll =====
  infinite = false,
  hasMore = false,
  isLoadingMore = false, // только для UI (спиннер)
  onLoadMore = () => {},
}) => {

  // ============================================================
  // ✅ FIX 1: refs — источник истины для защиты от гонок
  // ============================================================
  const isLoadingMoreRef = useRef(false);
  const lastCallTimeRef = useRef(0);
  const sentinelRef = useRef(null);

  // Синхронизируем ref с пропсом (для UI-спиннера)
  useEffect(() => {
    isLoadingMoreRef.current = isLoadingMore;
  }, [isLoadingMore]);

  // ============================================================
  // 1. Форматирование колонок (даты)
  // ============================================================
  const formattedColumns = useMemo(() => {
    return columns.map(column => {
      if (column.type === 'date') {
        return {
          ...column,
          cell: column.cell
            ? column.cell
            : (props) => formatDate(props.getValue()),
        };
      }
      return column;
    });
  }, [columns]);

  // ============================================================
  // 2. Состояния
  // ============================================================
  const [selectedRecord, setSelectedRecord] = useState(null);
  const [rowSelection, setRowSelection] = useState({});
  const [sorting, setSorting] = useState([]);
  const [mode, setMode] = useState(null);
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [hasUserInteracted, setHasUserInteracted] = useState(false);
  const [isFilterDialogOpen, setIsFilterDialogOpen] = useState(false);

  const [filterParams, setFilterParams] = useState({
    newident: initialNewIdent
  });

  const [isSimpleFilterActive, setIsSimpleFilterActive] = useState(false);
  const { permissions, isDeveloper } = useUiPermission();

  // ============================================================
  // 3. Синхронизация initialNewIdent
  // ============================================================
  useEffect(() => {
    setFilterParams(prev => ({ ...prev, newident: initialNewIdent }));
  }, [initialNewIdent]);

  // ============================================================
  // 4. ✅ FIXED Intersection Observer
  // ============================================================
  useEffect(() => {
    if (!infinite) return;

    const sentinel = sentinelRef.current;
    if (!sentinel) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const [entry] = entries;
        if (!entry.isIntersecting) return;

        // ✅ FIX: защита только через ref (state асинхронный)
        if (!hasMore || isLoadingMoreRef.current) return;

        // ✅ FIX: throttle 500ms — защита от дребезга observer
        const now = Date.now();
        if (now - lastCallTimeRef.current < 500) return;
        lastCallTimeRef.current = now;

        onLoadMore();
      },
      {
        root: null,
        rootMargin: '200px',
        threshold: 0.1
      }
    );

    observer.observe(sentinel);

    return () => {
      if (sentinel) observer.unobserve(sentinel);
    };
  }, [infinite, hasMore, onLoadMore]);

  // ============================================================
  // 5. Обработчики
  // ============================================================
  const handleRowClick = (row) => {
    setSelectedRecord(row.original);
    setHasUserInteracted(true);
    if (onRowSelect) {
      onRowSelect(row.original);
    }
  };

  const handleAddClick = () => {
    if (!initialNewIdent && record) {
      setSelectedRecord(record);
    } else {
      setSelectedRecord({ initialNewIdent });
    }
    setMode("add");
    setIsFormOpen(true);
  };

  const handleEditClick = (rec) => {
    setSelectedRecord(rec);
    setMode("edit");
    setIsFormOpen(true);
  };

  const handleDeleteClick = (rec) => {
    setSelectedRecord(rec);
    setMode("delete");
    setIsFormOpen(true);
  };

  const handleOpenFilterDialog = () => {
    setIsFilterDialogOpen(true);
  };

  const handleApplyFilters = (filters, filterType) => {
    const newFilterParams = { ...filters };
    setFilterParams(newFilterParams);
    setIsFilterDialogOpen(false);
    setIsSimpleFilterActive(filterType === 'simple');

    if (onApplyFilters) {
      onApplyFilters(newFilterParams);
    } else {
      reloadData(newFilterParams);
    }
  };

  const handleReload = () => {
    if (isSimpleFilterActive) {
      setFilterParams({});
      setIsSimpleFilterActive(false);
      reloadData();
    } else {
      reloadData(filterParams);
    }
  };

  const handleSuccess = (rec, mode) => {
    if (mode === "add") {
      setData(prev => [...prev, rec]);
      setSelectedRecord(rec);
      setRowSelection({ [rec[pk]]: true });
    } else if (mode === "edit") {
      setData(prev => prev.map(item => item[pk] === rec[pk] ? rec : item));
      setSelectedRecord(rec);
      setRowSelection({ [rec[pk]]: true });
    } else if (mode === "delete") {
      setData(prev => prev.filter(item => item[pk] !== rec[pk]));
      setSelectedRecord(null);
      setRowSelection({});
    }
    setIsFormOpen(false);
  };

  const handleFormClose = () => {
    setIsFormOpen(false);
  };

  // ============================================================
  // 6. Колонки
  // ============================================================
  const tableColumns = useMemo(() => {
    const final_col = [...formattedColumns];

    const canEdit = hasPermission(permissions, pageName, 'edit_btn', isDeveloper);
    const canDelete = hasPermission(permissions, pageName, 'delete_btn', isDeveloper);

    if (visibleToolbarButtons.includes('Действия') && (canEdit || canDelete)) {
      final_col.push({
        id: "actions",
        header: "Действия",
        cell: ({ row }) => (
          <div style={{ display: "flex", gap: "10px" }}>
            {canEdit && (
              <EditIcon
                titleAccess="Редактирование"
                sx={{ width: 20, cursor: "pointer" }}
                onClick={() => handleEditClick(row.original)}
              />
            )}
            {canDelete && (
              <DeleteForeverIcon
                titleAccess="Удаление"
                sx={{ width: 20, cursor: "pointer" }}
                onClick={() => handleDeleteClick(row.original)}
              />
            )}
          </div>
        )
      });
    }

    return final_col;
  }, [formattedColumns, permissions, pageName, isDeveloper, visibleToolbarButtons]);

  // ============================================================
  // 7. TanStack Table
  // ============================================================
  const table = useReactTable({
    data,
    columns: tableColumns,
    state: { sorting, rowSelection },
    onSortingChange: setSorting,
    getCoreRowModel: getCoreRowModel(),
    getSortedRowModel: getSortedRowModel(),
  });

  // ============================================================
  // 8. Рендер
  // ============================================================
  return (
    <div style={{ border: "1px solid #ccc" }}>
      {/* Toolbar */}
      <div
        className='tools-panel'
        style={{
          margin: '4px',
          display: "flex",
          position: "sticky",
          top: 0,
          zIndex: 1,
          background: "#fff"
        }}
      >
        {visibleToolbarButtons.includes('add') && (
          <CanAccess page={pageName} element="add_btn">
            <AddCircleOutlineIcon
              titleAccess="Добавить"
              sx={{ width: 30, cursor: 'pointer' }}
              onClick={handleAddClick}
            />
          </CanAccess>
        )}

        {visibleToolbarButtons.includes('filter') && (
          <FilterListIcon
            titleAccess="Фильтр"
            sx={{ width: 30, cursor: 'pointer', marginLeft: "10px" }}
            onClick={handleOpenFilterDialog}
          />
        )}

        {visibleToolbarButtons.includes('refresh') && (
          <RefreshIcon
            titleAccess="Обновить"
            style={{ width: 30, cursor: 'pointer', marginLeft: "10px" }}
            onClick={handleReload}
          />
        )}

        <Typography className='flex-1 text-center font-bold text-lg'>
          {title}
        </Typography>
      </div>

      {loading ? (
        <Box sx={{ display: "flex", justifyContent: "center", p: 4 }}>
          <CircularProgress />
        </Box>
      ) : (
        <>
          <table
            border="1"
            cellPadding="5"
            style={{ width: '100%', borderCollapse: 'collapse' }}
          >
            <thead>
              {table.getHeaderGroups().map((headerGroup) => (
                <tr key={headerGroup.id}>
                  {headerGroup.headers.map((header) => (
                    <th
                      key={header.id}
                      style={{
                        position: "sticky",
                        top: 0,
                        zIndex: 1,
                        background: "#f0f0f0",
                        border: "1px solid #ccc",
                        padding: "5px",
                        cursor: 'pointer'
                      }}
                      onClick={header.column.getToggleSortingHandler()}
                    >
                      {header.isPlaceholder
                        ? null
                        : flexRender(header.column.columnDef.header, header.getContext())
                      }
                      {{ asc: '↑', desc: '↓' }[header.column.getIsSorted()] ?? null}
                    </th>
                  ))}
                </tr>
              ))}
            </thead>

            <tbody>
              {table.getRowModel().rows.map((row) => (
                <tr
                  key={row.id}
                  onClick={() => handleRowClick(row)}
                  style={{
                    cursor: 'pointer',
                    backgroundColor:
                      (hasUserInteracted
                        ? selectedRecord
                        : (activeRecord || selectedRecord)
                      )?.[pk] === row.original[pk]
                        ? "#e6f7ff"
                        : "transparent",
                  }}
                >
                  {row.getVisibleCells().map((cell) => (
                    <td
                      key={cell.id}
                      className="border-b border-r border-gray-150 border-1 text-left py-1"
                    >
                      {flexRender(cell.column.columnDef.cell, cell.getContext())}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>

          {/* Infinite scroll sentinel */}
          {infinite && (
            <div style={{ padding: '12px 0', textAlign: 'center' }}>
              <div ref={sentinelRef} style={{ height: '1px', width: '100%' }} />

              {isLoadingMore && (
                <Box sx={{ display: 'flex', justifyContent: 'center', py: 1 }}>
                  <CircularProgress size={24} />
                </Box>
              )}

              {!hasMore && data.length > 0 && (
                <Typography variant="body2" color="text.secondary">
                  Все записи загружены
                </Typography>
              )}
            </div>
          )}
        </>
      )}

      {/* Диалог фильтрации */}
      {FilterComponent ? (
        <FilterComponent
          open={isFilterDialogOpen}
          onClose={() => setIsFilterDialogOpen(false)}
          onApply={handleApplyFilters}
          {...filterConfig}
          initialFilters={filterParams}
        />
      ) : (
        <FilterDialog
          open={isFilterDialogOpen}
          onClose={() => setIsFilterDialogOpen(false)}
          onApply={handleApplyFilters}
          izdatOptions={[]}
          initialFilters={filterParams}
        />
      )}

      {/* CRUD-форма */}
      {isFormOpen && FormComponent && (
        <FormComponent
          record={selectedRecord}
          mode={mode}
          onClose={handleFormClose}
          onSuccess={handleSuccess}
          open={isFormOpen}
        />
      )}
    </div>
  );
};

export default FlatTableInfinity;



