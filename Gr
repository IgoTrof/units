import React, { useEffect, useState, useMemo, useCallback, useRef } from "react";
import HierarchicalTable from "../components/UI/table/HierarchicalTable";
import EditDeleteFormSborn from "./EditDeleteFormSborn";
import { api } from "../config/api";
import { Panel, PanelGroup, PanelResizeHandle } from "react-resizable-panels";
import { Button, TextField } from "@mui/material";
import "tailwindcss";
import SbornStruArchiv from "./SbornStruArchiv";
import Vzamen from "./Vzamen";
import FlatTableInfinity from "../components/UI/table/FlatTableInfinity";

// =====================================================================
// Компонент каталога сборников
// =====================================================================
export default function CatalogeSborn() {

  // -----------------------------------------------------------------
  // STATE
  // -----------------------------------------------------------------
  const [dataCat, setDataCat] = useState([]);
  const [activeHierId, setActiveHierId] = useState(null);

  const [filterIndex, setFilterIndex] = useState();
  const [filterParams, setFilterParams] = useState({});
  const [myFilterParams, setMyFilterParams] = useState([
    { id: "newident", value: filterIndex || filterParams.newident || '1' }
  ]);

  const [loading, setLoading] = useState(true);
  const [loadingSborn, setLoadingSborn] = useState(false);
  const [isLoadingMore, setIsLoadingMore] = useState(false);

  const [filteredSbornData, setFilteredSbornData] = useState([]);
  const [rowSborn, setRowSborn] = useState();

  const [pageIndex, setPageIndex] = useState(1);
  const [totalCount, setTotalCount] = useState(0);
  const pageSize = 17;

  const hasMore = filteredSbornData.length < totalCount;

  // ✅ FIX: ref — единственный источник истины для блокировки подгрузки
  const isLoadingMoreRef = useRef(false);

  const [isSbornStruDialogOpen, setIsSbornStruDialogOpen] = useState(false);
  const [isVzamenDialogOpen, setIsVzamenDialogOpen] = useState(false);

  // -----------------------------------------------------------------
  // Утилита даты
  // -----------------------------------------------------------------
  const formatDate = (isoString) => {
    if (!isoString) return "";
    const date = new Date(isoString);
    return date.toLocaleDateString("ru-RU");
  };

  // -----------------------------------------------------------------
  // Загрузка дерева каталога
  // -----------------------------------------------------------------
  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        const hierResponse = await api.get('api/catalog/tree/');
        setDataCat(hierResponse.data);
      } catch (error) {
        console.error("Ошибка загрузки данных", error);
      } finally {
        setLoading(false);
      }
    };
    fetchData();
  }, []);

  // -----------------------------------------------------------------
  // Главная функция загрузки сборников
  // -----------------------------------------------------------------
  const loadSbornData = useCallback(
    async (params = {}, pageOverride = null, append = false) => {
      // ✅ FIX: защита от повторных запросов при append
      if (append && isLoadingMoreRef.current) return;

      try {
        if (append) {
          isLoadingMoreRef.current = true;
          setIsLoadingMore(true);
        } else {
          setLoadingSborn(true);
        }

        // ✅ FIX: берём страницу строго из аргумента, а не из возможно устаревшего state
        const page = pageOverride ?? 1;

        const allParams = {
          ...filterParams,
          ...params,
          newident: filterIndex ?? params.newident ?? filterParams.newident ?? '',
          paginate: true,
          page,
          page_size: pageSize,
        };

        // Новые фильтры → всегда с 1 страницы
        if (Object.keys(params).length > 0 && !append) {
          allParams.page = 1;
        }

        const queryParams = new URLSearchParams();
        Object.keys(allParams).forEach(key => {
          if (allParams[key] !== undefined && allParams[key] !== '' && allParams[key] !== null) {
            queryParams.append(key, allParams[key]);
          }
        });

        const response = await api.get(`api/sborn/?${queryParams.toString()}`);
        const data = response.data.results || response.data || [];

        setTotalCount(response.data.count || 0);

        // ✅ FIX: корректное обновление данных
        setFilteredSbornData(prev =>
          append ? [...prev, ...data] : data
        );

        // ✅ FIX: pageIndex обновляем только из запрошенной страницы
        setPageIndex(page);

        return response;
      } catch (error) {
        console.error("Ошибка загрузки данных сборников:", error);
        throw error;
      } finally {
        if (append) {
          isLoadingMoreRef.current = false;
          setIsLoadingMore(false);
        } else {
          setLoadingSborn(false);
        }
      }
    },
    [filterParams, filterIndex, pageSize]
  );

  // -----------------------------------------------------------------
  // Клик по дереву
  // -----------------------------------------------------------------
  const handleHierRowSelect = (row) => {
    const newFilterIndex = row.index;
    setActiveHierId(row.id);
    setFilterIndex(newFilterIndex);
    setFilterParams({ newident: newFilterIndex });

    setMyFilterParams((prev) => {
      const hasNewident = prev.some(column => column.id === "newident");
      if (hasNewident) {
        return prev.map(column =>
          column?.id === "newident"
            ? { ...column, value: newFilterIndex }
            : column
        );
      }
      return [...prev, { id: "newident", value: newFilterIndex }];
    });

    // ✅ FIX: сброс данных + загрузка первой страницы
    setFilteredSbornData([]);
    setPageIndex(1);
    loadSbornData({ newident: newFilterIndex }, 1, false);
  };

  // -----------------------------------------------------------------
  // Применение фильтров
  // -----------------------------------------------------------------
  const handleApplyFilters = (newFilters) => {
    setFilterParams(newFilters);

    // ✅ FIX: сброс данных перед загрузкой
    setFilteredSbornData([]);
    setPageIndex(1);

    loadSbornData(newFilters, 1, false);
  };

  // -----------------------------------------------------------------
  // Подгрузка следующей страницы
  // -----------------------------------------------------------------
  const handleLoadMore = useCallback(() => {
    // ✅ FIX: железная защита через ref
    if (!hasMore || isLoadingMoreRef.current || loadingSborn) return;

    const nextPage = pageIndex + 1;
    loadSbornData({}, nextPage, true);
  }, [hasMore, loadingSborn, pageIndex, loadSbornData]);

  // -----------------------------------------------------------------
  // Колонки
  // -----------------------------------------------------------------
  const colCat = useMemo(() => [
    { header: '', accessorKey: 'level_name', cell: (info) => info.getValue() },
    { header: 'Наименование', accessorKey: 'element_name', cell: (info) => info.getValue() },
  ], []);

  const colSb = useMemo(() => [
    { accessorKey: 'sborn_id', header: 'Код сбора', cell: (info) => info.getValue(), enableColumnFilter: true },
    { accessorKey: 'newident', header: 'Индекс', cell: (info) => info.getValue(), enableColumnFilter: true },
    { accessorKey: 'ident', header: 'Пред. индекс', cell: (info) => info.getValue(), enableColumnFilter: true },
    { accessorKey: 'name', header: 'Наименование', cell: (info) => info.getValue(), enableColumnFilter: true },
  ], []);

  // -----------------------------------------------------------------
  // Выбор сборника
  // -----------------------------------------------------------------
  const handleSelectSborn = (row) => {
    setRowSborn(row);
  };

  // -----------------------------------------------------------------
  // Рендер
  // -----------------------------------------------------------------
  if (loading && dataCat.length === 0) {
    return (
      <div style={{
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        height: "50vh"
      }}>
        <p>Загрузка данных каталога...</p>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-screen w-full p-2 overflow-hidden bg-white">
      <h3 className="text-[13px] font-semibold text-center mb-1.5 uppercase tracking-wide">
        Каталог сборников
      </h3>

      <PanelGroup
        id="catsborn_horiz1_layout"
        direction="horizontal"
        autoSaveId="catsborn-horiz1-layout"
        className="flex-grow border border-gray-200 rounded-lg overflow-hidden"
      >
        {/* Левая панель — дерево */}
        <Panel id="catsborn-left-panel" defaultSize={50} minSize={15}>
          <div className="h-full w-full p-1 overflow-auto">
            <HierarchicalTable
              data={dataCat}
              columns={colCat}
              onRowSelect={handleHierRowSelect}
              expandName="level_name"
              onSelect={setActiveHierId}
              activeId={activeHierId}
            />
          </div>
        </Panel>

        <PanelResizeHandle className="w-[5px] bg-gray-300 hover:bg-blue-400 transition-colors cursor-col-resize" />

        {/* Правая панель */}
        <Panel id="catsborn-right-panel" defaultSize={50} minSize={15}>
          <PanelGroup id="catsborn_vert1_layout" direction="vertical" autoSaveId="catsborn-vert1-layout">

            {/* Верхняя правая — таблица */}
            <Panel id="catsborn-top-layout" defaultSize={50} minSize={20}>
              <div className="h-full w-full p-2 flex flex-col justify-between overflow-hidden">
                <div className="flex-grow overflow-auto">
                  <FlatTableInfinity
                    pageName="catalogsborn"
                    data={filteredSbornData}
                    columns={colSb}
                    pk="sborn_id"
                    setData={setFilteredSbornData}
                    reloadData={loadSbornData}
                    FormComponent={EditDeleteFormSborn}
                    initialNewIdent={filterIndex}
                    onApplyFilters={handleApplyFilters}
                    loading={loadingSborn}
                    onRowSelect={handleSelectSborn}

                    infinite={true}
                    hasMore={hasMore}
                    isLoadingMore={isLoadingMore}
                    onLoadMore={handleLoadMore}
                  />
                </div>
              </div>
            </Panel>

            <PanelResizeHandle className="h-[5px] bg-gray-200 hover:bg-blue-400 transition-colors cursor-row-resize" />

            {/* Нижняя правая — детализация */}
            <Panel id="catsborn-top2-layout" defaultSize={50} minSize={20}>
              <div className="h-full w-full m-34">
                <PanelGroup id="sub-horizontal-group" direction="horizontal" autoSaveId="catsborn_-horiz2-layout">

                  {/* Левая сторона детализации */}
                  <Panel id="left-form-panel" defaultSize={60} minSize={30}>
                    <div className="h-full w-full flex flex-col items-stretch justify-start bg-white shadow-md px-5 pt-4 pb-6 gap-4 overflow-auto rounded-l-lg">

                      <TextField
                        fullWidth
                        margin="normal"
                        size="small"
                        label="Полное наименование"
                        name="fname"
                        value={rowSborn?.fname || ""}
                        multiline
                        maxRows={3}
                      />

                      {/* БЛОК 1: Архив и Коэффициент */}
                      <div className="flex flex-col items-start justify-start gap-4 w-full my-2">
                        <div className="flex flex-row items-end justify-start gap-[30px] flex-wrap w-full">
                          <div>
                            <TextField
                              label="Архив"
                              name="arhiv"
                              size="small"
                              variant="standard"
                              value={
                                rowSborn?.arhiv === 0 ? "Действующий" :
                                rowSborn?.arhiv === 1 ? "В архиве" : ""
                              }
                            />
                          </div>
                          <div>
                            <Button
                              variant="contained"
                              className="!normal-case !bg-[rgba(240,240,240,0.8)] hover:!bg-[rgba(240,240,240,1)] !text-black"
                              onClick={() => setIsSbornStruDialogOpen(true)}
                              sx={{
                                ...(!rowSborn?.sborn_id && {
                                  pointerEvents: 'none',
                                  opacity: 0.5,
                                })
                              }}
                            >
                              Посмотреть структуры в архиве
                            </Button>
                          </div>
                        </div>

                        <div className="flex flex-row items-end justify-start gap-[30px] flex-wrap w-full">
                          <div>
                            <TextField
                              label="Поправочный коэффициент"
                              name="koef"
                              size="small"
                              variant="standard"
                              value={rowSborn?.koef || ''}
                            />
                          </div>
                          <div>
                            <Button
                              variant="contained"
                              className="!normal-case !bg-[rgba(240,240,240,0.8)] hover:!bg-[rgba(240,240,240,1)] !text-black"
                              onClick={() => {
                                if (!rowSborn?.sborn_id) return;
                                setIsVzamenDialogOpen(true);
                              }}
                              sx={{
                                ...(!rowSborn?.sborn_id && {
                                  pointerEvents: 'none',
                                  opacity: 0.5,
                                })
                              }}
                            >
                              Введен взамен
                            </Button>
                          </div>
                        </div>
                      </div>

                      {/* БЛОК 2: Даты и Документы */}
                      <div className="flex flex-row items-end justify-start gap-2 flex-wrap w-full">
                        <div className="flex flex-row items-end justify-start gap-[30px] flex-wrap w-full">
                          <div>
                            <TextField
                              label="Дата ввода"
                              name="srok1"
                              size="small"
                              variant="standard"
                              value={formatDate(rowSborn?.srok1) || ''}
                            />
                          </div>
                          <div className="flex-grow">
                            <TextField
                              label="Утверждающий документ"
                              name="utv_data"
                              size="small"
                              variant="standard"
                              value={rowSborn?.utv_doc || ''}
                              fullWidth
                            />
                          </div>
                        </div>
                      </div>

                      <div className="flex flex-row items-end justify-start gap-[30px] flex-wrap w-full">
                        <div>
                          <TextField
                            label="Дата ограничения"
                            name="srok2"
                            size="small"
                            variant="standard"
                            value={formatDate(rowSborn?.srok2) || ''}
                          />
                        </div>
                        <div className="flex-grow">
                          <TextField
                            label="Ограничивающий документ"
                            name="ogr_data"
                            size="small"
                            variant="standard"
                            value={rowSborn?.ogr_doc || ''}
                            fullWidth
                          />
                        </div>
                      </div>

                      {rowSborn?.prim && (
                        <TextField
                          fullWidth
                          margin="normal"
                          size="small"
                          label="Примечания"
                          name="prim"
                          value={rowSborn?.prim || ""}
                          multiline
                          maxRows={3}
                        />
                      )}

                      {rowSborn?.annotat && (
                        <TextField
                          fullWidth
                          margin="normal"
                          size="small"
                          label="Аннотация"
                          name="annotat"
                          value={rowSborn?.annotat || ""}
                          multiline
                          maxRows={3}
                        />
                      )}

                      {rowSborn?.dop_prim && (
                        <TextField
                          fullWidth
                          margin="normal"
                          size="small"
                          label="Доп.примечания"
                          name="dop_prim"
                          value={rowSborn?.dop_prim || ""}
                          multiline
                          maxRows={3}
                        />
                      )}
                    </div>
                  </Panel>

                  <PanelResizeHandle className="w-1.5 bg-gray-200 hover:bg-blue-500 active:bg-blue-600 transition-colors cursor-ew-resize" />

                  {/* Правая сторона — Предприятия */}
                  <Panel id="catsborn-right-layout" defaultSize={40} minSize={20}>
                    <div className="h-full w-full bg-white shadow-md flex flex-col rounded-r-lg overflow-hidden">
                      <br />
                      <TextField
                        fullWidth
                        name="right_text_field"
                        multiline
                        value={
                          rowSborn?.enterps_detail && rowSborn.enterps_detail.length > 0
                            ? rowSborn.enterps_detail.map(item => ' - ' + item.name).join('\n')
                            : ""
                        }
                        variant="standard"
                        inputProps={{ spellCheck: false }}
                        sx={{
                          height: '100%',
                          '& .MuiInputBase-root': {
                            height: '100%',
                            alignItems: 'flex-start',
                            padding: '16px',
                            '&:before, &:after': {
                              display: 'none',
                            }
                          },
                          '& .MuiInputBase-input': {
                            height: '100% !important',
                            overflowY: 'auto !important',
                            whiteSpace: 'pre-wrap !important',
                          }
                        }}
                        placeholder="Предприятия:"
                      />
                    </div>
                  </Panel>
                </PanelGroup>
              </div>
            </Panel>
          </PanelGroup>
        </Panel>
      </PanelGroup>

      {/* Диалоги */}
      <SbornStruArchiv
        open={isSbornStruDialogOpen}
        onClose={() => setIsSbornStruDialogOpen(false)}
        sborn={rowSborn}
      />
      <Vzamen
        open={isVzamenDialogOpen}
        onClose={() => setIsVzamenDialogOpen(false)}
        sborn={rowSborn}
      />
    </div>
  );
}
