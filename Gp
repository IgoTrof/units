import React, { useCallback, useEffect, useRef, useState } from "react";
import FlatTableInfinity from "./FlatTableInfinity";
import api from "@/api";

const pageSize = 20;

const CatalogeSborn = () => {
  const [filteredSbornData, setFilteredSbornData] = useState([]);
  const [loadingSborn, setLoadingSborn] = useState(false);
  const [isLoadingMore, setIsLoadingMore] = useState(false);
  const [pageIndex, setPageIndex] = useState(1);
  const [totalCount, setTotalCount] = useState(0);
  const [filterParams, setFilterParams] = useState({});

  // ✅ FIX: защита от двойных запросов
  const isLoadingMoreRef = useRef(false);

  const hasMore = filteredSbornData.length < totalCount;

  const loadSbornData = useCallback(
    async (params = {}, pageOverride = null, append = false) => {

      // ✅ FIX: защита от гонок
      if (append && isLoadingMoreRef.current) return;

      try {
        if (append) {
          isLoadingMoreRef.current = true;
          setIsLoadingMore(true);
        } else {
          setLoadingSborn(true);
        }

        const page = pageOverride ?? 1;

        const requestParams = {
          ...filterParams,
          ...params,
          paginate: true,
          page,
          page_size: pageSize,
        };

        const queryParams = new URLSearchParams(requestParams);

        const response = await api.get(`api/sborn/?${queryParams}`);

        const results = response.data.results || [];
        const count = response.data.count || 0;

        // ✅ FIX: append вместо перезаписи
        setFilteredSbornData(prev =>
          append ? [...prev, ...results] : results
        );

        setTotalCount(count);

        // ✅ FIX: pageIndex строго из аргумента
        setPageIndex(page);

      } catch (error) {
        console.error("Ошибка загрузки:", error);
      } finally {
        setLoadingSborn(false);
        setIsLoadingMore(false);

        // ✅ FIX: снимаем блокировку
        isLoadingMoreRef.current = false;
      }
    },
    [filterParams]
  );

  const handleLoadMore = useCallback(() => {

    // ✅ FIX: защита
    if (isLoadingMoreRef.current || loadingSborn) return;

    const nextPage = pageIndex + 1;

    loadSbornData({}, nextPage, true);

  }, [pageIndex, loadSbornData, loadingSborn]);

  // первая загрузка
  useEffect(() => {
    loadSbornData({}, 1, false);
  }, []);

  // применение фильтров
  const applyFilters = (newFilters) => {

    setFilterParams(newFilters);

    // ✅ FIX: сброс списка
    setFilteredSbornData([]);
    setPageIndex(1);

    loadSbornData(newFilters, 1, false);
  };

  return (
    <FlatTableInfinity
      data={filteredSbornData}
      loading={loadingSborn}
      isLoadingMore={isLoadingMore}
      hasMore={hasMore}
      onLoadMore={handleLoadMore}
    />
  );
};

export default CatalogeSborn;

