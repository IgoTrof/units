                      ✅ FlatTableInfinity.jsx (исправленный)
// ===============================================================================

import React, { useEffect, useRef } from "react";

const FlatTableInfinity = ({
  data,
  loading,
  isLoadingMore,
  hasMore,
  onLoadMore,
}) => {
  const observerRef = useRef(null);
  const lastElementRef = useRef(null);

  // ✅ FIX: актуальное состояние загрузки
  const isLoadingMoreRef = useRef(false);

  useEffect(() => {
    isLoadingMoreRef.current = isLoadingMore;
  }, [isLoadingMore]);

  // ✅ FIX: защита от спама observer
  const lastCallTimeRef = useRef(0);

  useEffect(() => {
    if (loading) return;

    if (observerRef.current) observerRef.current.disconnect();

    observerRef.current = new IntersectionObserver((entries) => {
      const entry = entries[0];
      const now = Date.now();

      // ✅ FIX: throttle
      if (now - lastCallTimeRef.current < 500) return;

      if (
        entry.isIntersecting &&
        hasMore &&
        !isLoadingMoreRef.current
      ) {
        lastCallTimeRef.current = now;
        onLoadMore();
      }
    });

    if (lastElementRef.current) {
      observerRef.current.observe(lastElementRef.current);
    }

    return () => observerRef.current?.disconnect();
  }, [data, hasMore, loading, onLoadMore]);

  return (
    <div>
      {data.map((item, index) => {
        if (index === data.length - 1) {
          return (
            <div ref={lastElementRef} key={item.id}>
              {item.name}
            </div>
          );
        }

        return <div key={item.id}>{item.name}</div>;
      })}

      {loading && <div>Загрузка...</div>}
      {isLoadingMore && <div>Подгрузка...</div>}
    </div>
  );
};

export default FlatTableInfinity;



